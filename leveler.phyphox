<phyphox version="1.19">
    <title>Leveler</title>
    <category>Tools</category>
    <description>Dual-Axis Crosshair Gauge with Dynamic Sensor Orientation</description>

    <data-containers>
        <!-- Streaming Angle Inputs (8 bytes float32 from BLE: pitch, roll) -->
        <container size="1">pitch_now</container>
        <container size="1">roll_now</container>

        <!-- Un-tared Raw Angles for Zero Calibration Button -->
        <container size="1">pitch_raw</container>
        <container size="1">roll_raw</container>

        <!-- Stored Configuration Containers -->
        <container size="1">mount_usbc</container>
        <container size="1">mount_top</container>
        <container size="1">pitch_offset</container>
        <container size="1">roll_offset</container>
        <container size="1">th_front</container>
        <container size="1">th_rear</container>
        <container size="1">th_left</container>
        <container size="1">th_right</container>

        <!-- Dynamic Threshold Buffers -->
        <container size="1">neg_th_rear</container>
        <container size="1">neg_th_left</container>

        <!-- Static Geometry for 1:1 Crosshair Gauge -->
        <container size="1" static="true" init="0.0">cursor_zero</container>
        <container size="2" static="true" init="-10.0, 10.0">range_long</container>
        <container size="2" static="true" init="0.0, 0.0">const_zero</container>
        <container size="2" static="true" init="-0.8, 0.8">tick_short</container>

        <!-- Dynamic Geometry for Comfort Zones and Ticks -->
        <container size="2">zone_pitch</container>
        <container size="2">zone_roll</container>
        <container size="2">tick_pitch_front_y</container>
        <container size="2">tick_pitch_rear_y</container>
        <container size="2">tick_roll_left_x</container>
        <container size="2">tick_roll_right_x</container>
    </data-containers>

    <input>
        <!-- Single BLE device connection handling both notifications and indications -->
        <bluetooth
            id="leveler"
            uuid="a0000001-4493-41db-9609-eb926bd307c7"
            mtu="128"
            subscribeOnStart="true"
            autoConnect="true"
        >
            <!-- Streaming computed angle notifications -->
            <output
                char="a0000002-4493-41db-9609-eb926bd307c7"
                offset="0"
                length="4"
                conversion="float32LittleEndian"
            >pitch_now</output>
            <output
                char="a0000002-4493-41db-9609-eb926bd307c7"
                offset="4"
                length="4"
                conversion="float32LittleEndian"
            >roll_now</output>

            <!-- Stored configuration indications / notifications -->
            <output
                char="a0000003-4493-41db-9609-eb926bd307c7"
                offset="0"
                length="1"
                conversion="singleByte"
            >mount_usbc</output>
            <output
                char="a0000003-4493-41db-9609-eb926bd307c7"
                offset="1"
                length="1"
                conversion="singleByte"
            >mount_top</output>
            <output
                char="a0000003-4493-41db-9609-eb926bd307c7"
                offset="2"
                length="4"
                conversion="float32LittleEndian"
            >pitch_offset</output>
            <output
                char="a0000003-4493-41db-9609-eb926bd307c7"
                offset="6"
                length="4"
                conversion="float32LittleEndian"
            >roll_offset</output>
            <output
                char="a0000003-4493-41db-9609-eb926bd307c7"
                offset="10"
                length="4"
                conversion="float32LittleEndian"
            >th_front</output>
            <output
                char="a0000003-4493-41db-9609-eb926bd307c7"
                offset="14"
                length="4"
                conversion="float32LittleEndian"
            >th_rear</output>
            <output
                char="a0000003-4493-41db-9609-eb926bd307c7"
                offset="18"
                length="4"
                conversion="float32LittleEndian"
            >th_left</output>
            <output
                char="a0000003-4493-41db-9609-eb926bd307c7"
                offset="22"
                length="4"
                conversion="float32LittleEndian"
            >th_right</output>
        </bluetooth>
    </input>

    <output>
        <!-- Transmit updated configuration back to the device upon user modifications -->
        <bluetooth
            id="leveler"
            uuid="a0000001-4493-41db-9609-eb926bd307c7"
            mtu="128"
            autoConnect="true"
        >
            <input
                char="a0000003-4493-41db-9609-eb926bd307c7"
                offset="0"
                conversion="singleByte"
            >mount_usbc</input>
            <input
                char="a0000003-4493-41db-9609-eb926bd307c7"
                offset="1"
                conversion="singleByte"
            >mount_top</input>
            <input
                char="a0000003-4493-41db-9609-eb926bd307c7"
                offset="2"
                conversion="float32LittleEndian"
            >pitch_offset</input>
            <input
                char="a0000003-4493-41db-9609-eb926bd307c7"
                offset="6"
                conversion="float32LittleEndian"
            >roll_offset</input>
            <input
                char="a0000003-4493-41db-9609-eb926bd307c7"
                offset="10"
                conversion="float32LittleEndian"
            >th_front</input>
            <input
                char="a0000003-4493-41db-9609-eb926bd307c7"
                offset="14"
                conversion="float32LittleEndian"
            >th_rear</input>
            <input
                char="a0000003-4493-41db-9609-eb926bd307c7"
                offset="18"
                conversion="float32LittleEndian"
            >th_left</input>
            <input
                char="a0000003-4493-41db-9609-eb926bd307c7"
                offset="22"
                conversion="float32LittleEndian"
            >th_right</input>
        </bluetooth>
    </output>

    <analysis>
        <!-- 1. Recover un-tared raw angles for the tare button -->
        <formula formula="[1] + [2]">
            <input clear="false">pitch_now</input>
            <input clear="false">pitch_offset</input>
            <output>pitch_raw</output>
        </formula>
        <formula formula="[1] + [2]">
            <input clear="false">roll_now</input>
            <input clear="false">roll_offset</input>
            <output>roll_raw</output>
        </formula>

        <!-- 2. Threshold Bound Calculations and Dynamic Geometry Generation -->
        <formula formula="-[1]">
            <input clear="false">th_rear</input>
            <output>neg_th_rear</output>
        </formula>
        <formula formula="-[1]">
            <input clear="false">th_left</input>
            <output>neg_th_left</output>
        </formula>

        <!-- Pitch comfort zone segment [-th_rear, th_front] -->
        <append>
            <input clear="false">neg_th_rear</input>
            <input clear="false">th_front</input>
            <output>zone_pitch</output>
        </append>

        <!-- Roll comfort zone segment [-th_left, th_right] -->
        <append>
            <input clear="false">neg_th_left</input>
            <input clear="false">th_right</input>
            <output>zone_roll</output>
        </append>

        <!-- Pitch Front tick Y segment [th_front, th_front] -->
        <append>
            <input clear="false">th_front</input>
            <input clear="false">th_front</input>
            <output>tick_pitch_front_y</output>
        </append>

        <!-- Pitch Rear tick Y segment [-th_rear, -th_rear] -->
        <append>
            <input clear="false">neg_th_rear</input>
            <input clear="false">neg_th_rear</input>
            <output>tick_pitch_rear_y</output>
        </append>

        <!-- Roll Left tick X segment [-th_left, -th_left] -->
        <append>
            <input clear="false">neg_th_left</input>
            <input clear="false">neg_th_left</input>
            <output>tick_roll_left_x</output>
        </append>

        <!-- Roll Right tick X segment [th_right, th_right] -->
        <append>
            <input clear="false">th_right</input>
            <input clear="false">th_right</input>
            <output>tick_roll_right_x</output>
        </append>
    </analysis>

    <views>
        <!-- VIEW 1: DUAL-AXIS LEVEL GAUGES -->
        <view label="Leveling">
            <graph
                unitX="°"
                unitY="°"
                aspectRatio="1"
                scaleMinX="fixed"
                scaleMaxX="fixed"
                scaleMinY="fixed"
                scaleMaxY="fixed"
                minX="-10.0"
                maxX="10.0"
                minY="-10.0"
                maxY="10.0"
            >
                <!-- Pitch main rail (Gray) -->
                <input
                    axis="x"
                    color="444444"
                    lineWidth="2"
                    style="lines"
                >const_zero</input>
                <input
                    axis="y"
                    color="444444"
                    lineWidth="2"
                    style="lines"
                >range_long</input>

                <!-- Pitch comfort zone (Thick Cyan line) -->
                <input
                    axis="x"
                    color="00e5ff"
                    lineWidth="6"
                    style="lines"
                >const_zero</input>
                <input
                    axis="y"
                    color="00e5ff"
                    lineWidth="6"
                    style="lines"
                >zone_pitch</input>

                <!-- Pitch Front threshold tick (Cyan) -->
                <input
                    axis="x"
                    color="00e5ff"
                    lineWidth="2"
                    style="lines"
                >tick_short</input>
                <input
                    axis="y"
                    color="00e5ff"
                    lineWidth="2"
                    style="lines"
                >tick_pitch_front_y</input>

                <!-- Pitch Rear threshold tick (Cyan) -->
                <input
                    axis="x"
                    color="00e5ff"
                    lineWidth="2"
                    style="lines"
                >tick_short</input>
                <input
                    axis="y"
                    color="00e5ff"
                    lineWidth="2"
                    style="lines"
                >tick_pitch_rear_y</input>

                <!-- Roll main rail (Gray) -->
                <input
                    axis="x"
                    color="444444"
                    lineWidth="2"
                    style="lines"
                >range_long</input>
                <input
                    axis="y"
                    color="444444"
                    lineWidth="2"
                    style="lines"
                >const_zero</input>

                <!-- Roll comfort zone (Thick Green line) -->
                <input
                    axis="x"
                    color="00e676"
                    lineWidth="6"
                    style="lines"
                >zone_roll</input>
                <input
                    axis="y"
                    color="00e676"
                    lineWidth="6"
                    style="lines"
                >const_zero</input>

                <!-- Roll Left threshold tick (Green) -->
                <input
                    axis="x"
                    color="00e676"
                    lineWidth="2"
                    style="lines"
                >tick_roll_left_x</input>
                <input
                    axis="y"
                    color="00e676"
                    lineWidth="2"
                    style="lines"
                >tick_short</input>

                <!-- Roll Right threshold tick (Green) -->
                <input
                    axis="x"
                    color="00e676"
                    lineWidth="2"
                    style="lines"
                >tick_roll_right_x</input>
                <input
                    axis="y"
                    color="00e676"
                    lineWidth="2"
                    style="lines"
                >tick_short</input>

                <!-- Pitch Cursor: Slides vertically (Cyan Dot) -->
                <input
                    axis="x"
                    color="00e5ff"
                    lineWidth="14"
                    style="dots"
                >cursor_zero</input>
                <input
                    axis="y"
                    color="00e5ff"
                    lineWidth="14"
                    style="dots"
                >pitch_now</input>

                <!-- Roll Cursor: Slides horizontally (Green Dot) -->
                <input
                    axis="x"
                    color="00e676"
                    lineWidth="14"
                    style="dots"
                >roll_now</input>
                <input
                    axis="y"
                    color="00e676"
                    lineWidth="14"
                    style="dots"
                >cursor_zero</input>
            </graph>

            <value label="Front / Back Angle" unit="°" precision="1">
                <input>pitch_now</input>
            </value>
            <value label="Left / Right Angle" unit="°" precision="1">
                <input>roll_now</input>
            </value>
        </view>

        <!-- VIEW 2: DEVICE CONFIGURATION -->
        <view label="Settings">
            <!-- USER CONTROLS -->
            <dropdown label="USB-C Port Points To">
                <output>mount_usbc</output>
                <map value="1.0">1. Front</map>
                <map value="2.0">2. Rear</map>
                <map value="3.0">3. Left (Driver)</map>
                <map value="4.0">4. Right (Passenger)</map>
                <map value="5.0">5. Up (Roof)</map>
                <map value="6.0">6. Down (Floor)</map>
            </dropdown>

            <dropdown label="Top Label Points To">
                <output>mount_top</output>
                <map value="1.0">1. Front</map>
                <map value="2.0">2. Rear</map>
                <map value="3.0">3. Left (Driver)</map>
                <map value="4.0">4. Right (Passenger)</map>
                <map value="5.0">5. Up (Roof)</map>
                <map value="6.0">6. Down (Floor)</map>
            </dropdown>

            <!-- THRESHOLD CONTROLS -->
            <edit
                decimal="true"
                label="Front Tolerance Limit"
                max="10.0"
                min="0.1"
                signed="false"
                unit="°"
            >
                <output>th_front</output>
            </edit>
            <edit
                decimal="true"
                label="Rear Tolerance Limit"
                max="10.0"
                min="0.1"
                signed="false"
                unit="°"
            >
                <output>th_rear</output>
            </edit>
            <edit
                decimal="true"
                label="Left Tolerance Limit"
                max="10.0"
                min="0.1"
                signed="false"
                unit="°"
            >
                <output>th_left</output>
            </edit>
            <edit
                decimal="true"
                label="Right Tolerance Limit"
                max="10.0"
                min="0.1"
                signed="false"
                unit="°"
            >
                <output>th_right</output>
            </edit>

            <!-- ZERO LEVEL CALIBRATION -->
            <edit
                decimal="true"
                label="Front / Back Zero Level"
                max="45.0"
                min="-45.0"
                signed="true"
                unit="°"
            >
                <output>pitch_offset</output>
            </edit>
            <edit
                decimal="true"
                label="Left / Right Zero Level"
                max="45.0"
                min="-45.0"
                signed="true"
                unit="°"
            >
                <output>roll_offset</output>
            </edit>

            <button label="Set Zero Level">
                <input>pitch_raw</input><output>pitch_offset</output>
                <input>roll_raw</input><output>roll_offset</output>
            </button>

            <button label="Reset Zero Level">
                <input type="value">0.0</input><output>pitch_offset</output>
                <input type="value">0.0</input><output>roll_offset</output>
            </button>
        </view>
    </views>
</phyphox>
